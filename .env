# =============================================================================
# DNSC – un singur fișier pentru toate credentialele (compose + backend)
# =============================================================================
# Compose citește .env din rădăcina proiectului. Backend încarcă același fișier
# (config.go citește din rădăcina proiectului). În Docker, POSTGRES_DB_HOST e
# suprascris la dnsc-postgres (numele serviciului din aceeași rețea).
# =============================================================================

# API
SERVER_PORT=8080
ENVIRONMENT=development
DEBUG_MODE=false

# PostgreSQL (folosit de compose pentru containerul postgres și de backend pentru conexiune)
POSTGRES_DB_USER=dnsc_user
POSTGRES_DB_PASSWORD=dnsc_password
POSTGRES_DB_NAME=dnsc_db
POSTGRES_DB_PORT=5432
POSTGRES_DB_SSLMODE=disable

# Când rulezi backend în Docker, compose setează POSTGRES_DB_HOST=dnsc-postgres.
# Când rulezi backend local (go run), pune aici localhost.
POSTGRES_DB_HOST=dnsc-postgres

# -----------------------------------------------------------------------------
# Domain auto-whitelist scheduler
# -----------------------------------------------------------------------------
DOMAIN_AUTO_WHITELIST_ENABLED=true
DOMAIN_AUTO_WHITELIST_SCHEDULE=0 0 2 * * *
DOMAIN_AUTO_WHITELIST_TIMEZONE=Europe/Bucharest
DOMAIN_INACTIVITY_DAYS=180
DOMAIN_AUTO_WHITELIST_CHANGED_BY=system
DOMAIN_AUTO_WHITELIST_NOTES=Auto-whitelisted by system.

# -----------------------------------------------------------------------------
# RTIR Play – SearchTickets + GetTicketByID, checkpoint + upsert by rtir_ticket_id
# DOMAIN_RTIR_PLAY_SYNC_OVERLAP_MINUTES – scade din last sync la cutoff (default 5)
# DOMAIN_RTIR_PLAY_SYNC_SKIP_TLS_VERIFY=true doar dacă certificatul intern nu e în trust store
# -----------------------------------------------------------------------------
DOMAIN_RTIR_PLAY_SYNC_ENABLED=true
DOMAIN_RTIR_PLAY_SYNC_URL=https://rtir-play.dnsc.ro
DOMAIN_RTIR_PLAY_SYNC_SCHEDULE=0 */10 * * * *
DOMAIN_RTIR_PLAY_SYNC_TIMEZONE=Europe/Bucharest
DOMAIN_RTIR_PLAY_SYNC_TOKEN=1-548844-84b54b1582b2978a6b25929feaeae392
DOMAIN_RTIR_PLAY_SYNC_OVERLAP_MINUTES=5
DOMAIN_RTIR_PLAY_SYNC_SKIP_TLS_VERIFY=true

# -----------------------------------------------------------------------------
# Dozzle – log-uri live pentru containere (UI: http://localhost:<DOZZLE_PORT>)
# -----------------------------------------------------------------------------
DOZZLE_PORT=3001
